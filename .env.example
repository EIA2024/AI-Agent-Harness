# Personal AI OS — environment configuration
# Copy to .env and adjust.

# --- Database ---
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/personal_ai_os
# SQLite (local dev / quick start):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# --- LLM provider ---
# Preferred: use `personal-ai config init` to set up one or more local
# provider profiles (OpenAI/Anthropic/DeepSeek/...) — stored OUTSIDE the repo
# in ~/.personal_ai/profiles.json (or $PERSONAL_AI_CONFIG_DIR/profiles.json).
# The env vars below are legacy fallbacks used when no profile is active.
ANTHROPIC_API_KEY=
# Default model role assignments (router/worker/vision)
MODEL_WORKER=claude-sonnet-5
MODEL_ROUTER=claude-haiku-4-5

# Optional: override where provider profiles are stored (default ~/.personal_ai)
# PERSONAL_AI_CONFIG_DIR=C:/Users/<you>/.personal_ai

# --- API ---
APP_ENV=development
PERSONAL_AI_API_URL=http://localhost:8000
# Server-side dev API key (creates a dev owner user on startup; leave blank to disable dev mode):
PERSONAL_AI_DEV_API_KEY=replace-with-a-local-secret
# Client-side key used by the CLI (must match one of the keys in the users table):
PERSONAL_AI_API_KEY=replace-with-a-local-secret
# HMAC secret used to hash API keys at rest (required in production):
PERSONAL_AI_KEY_HASH_SECRET=replace-with-a-long-random-value
# Connector security boundaries (both are required in production):
PERSONAL_AI_WORKSPACE_ROOT=.
PERSONAL_AI_HTTP_ALLOWED_DOMAINS=example.com
PERSONAL_AI_HOST=0.0.0.0
PERSONAL_AI_PORT=8000

# --- Credentials (Credential Broker MVP: env-based secret store) ---
# Format: CRED_<SCOPE_SAFE>_<PROVIDER>
# e.g. GitHub read token for connector scope "github.read":
# CRED_GITHUB_READ=ghp_xxxx
# e.g. Gmail read token for connector scope "gmail.read":
# CRED_GMAIL_READ=ya29.xxxx

# --- Sandbox ---
SANDBOX_ENABLED=false
SANDBOX_DOCKER_IMAGE=python:3.12-slim

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CONTENT_LOGGING=false
